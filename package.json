{
  "name": "purser",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "abi": "node scripts/gen-abi.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "server": "tsx --env-file-if-exists=.env.local packages/server/src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "dev:console": "npm run dev -w @purser/console"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "engines": {
    "node": ">=22"
  }
}
