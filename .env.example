# Purser server configuration. Copy to .env.local (local chain) or .env.<network>.
# scripts/local-up.sh and scripts/deploy-testnet.sh write these for you.

# Chain and account
PURSER_RPC_URL=http://127.0.0.1:8545
# Either point at a deployment file written by the SeedDemo script...
PURSER_DEPLOYMENT=contracts/deployments/31337.demo.json
# ...or set the account and EntryPoint directly.
# PURSER_ACCOUNT=0x...
# PURSER_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# PURSER_FROM_BLOCK=0   # where to start reading account events

# Keys. The server holds the agent's session key only.
PURSER_AGENT_PRIVATE_KEY=0x...
# Pays for handleOps when there is no bundler (the account refunds it). Defaults to the agent key.
PURSER_RELAYER_PRIVATE_KEY=0x...
# Or submit through an ERC-4337 bundler instead of self-bundling.
# PURSER_BUNDLER_URL=https://...

# Demo mode only: lets the console approve, freeze and revoke without a browser wallet.
# The server refuses an owner key unless PURSER_DEMO=true. Never use with real funds.
PURSER_DEMO=false
# PURSER_OWNER_PRIVATE_KEY=0x...

# Names the agent can use instead of addresses
# PURSER_ADDRESS_BOOK=merchant=0x...,shop=0x...
# PURSER_TOKENS=USDC=0x...

# HTTP server
PURSER_HOST=127.0.0.1
PURSER_PORT=8787
PURSER_CONSOLE_DIR=apps/console/dist
PURSER_DATA_DIR=.purser
# Bearer token required for POST /api/* (approvals, freeze). Recommended when not on localhost.
# PURSER_API_TOKEN=
# PURSER_EXPLORER_URL=https://sepolia.basescan.org
